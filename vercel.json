{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/healthz", "destination": "/api/index?__path=/healthz" },
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/auth/:path*", "destination": "/api/index?__path=/auth/:path*" },
    { "source": "/family/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
